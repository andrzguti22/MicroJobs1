# =========================================
# Base de datos
# =========================================
# ⚠️ NUNCA subas tu .env real con la contraseña verdadera a git.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/microjobs

# =========================================
# Seguridad / JWT
# =========================================
# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =========================================
# Configuración de envío de correos (Resend)
# =========================================
# Copia este archivo como ".env" en la carpeta Backend/ y completa tus datos reales.
# NUNCA subas el archivo ".env" real a un repositorio público.
#
# Se usa la API HTTP de Resend en vez de SMTP porque Render bloquea el
# tráfico saliente por los puertos SMTP (25, 465, 587) en el plan gratis.
#
# 1. Crea una cuenta gratis en https://resend.com (3,000 correos/mes gratis)
# 2. Genera un API Key en https://resend.com/api-keys
# 3. Pégalo abajo en RESEND_API_KEY
RESEND_API_KEY=re_tu_api_key_de_resend
EMAIL_FROM_NAME=MicroJobs
# Mientras no verifiques tu propio dominio en Resend, solo puedes usar esta
# dirección de prueba, y solo te llegarán correos a TU cuenta de Resend.
# Para enviar a cualquier usuario real, verifica un dominio en
# https://resend.com/domains y usa una dirección de ese dominio aquí.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# URL del frontend, usada para armar el link de recuperación de contraseña
# En producción, usa la URL real de Vercel, ej:
# FRONTEND_URL=https://micro-jobs1-peach.vercel.app
FRONTEND_URL=http://localhost:5173

# =========================================
# CORS
# =========================================
# Orígenes adicionales permitidos a llamar la API (separados por coma).
# localhost:5173 ya está permitido por defecto para desarrollo local.
# En producción agrega la URL de tu frontend en Vercel, ej:
# ALLOWED_ORIGINS=https://micro-jobs1-peach.vercel.app
ALLOWED_ORIGINS=

# =========================================
# Supabase Storage (imágenes de perfil y portafolio)
# =========================================
# Antes las imágenes se guardaban en disco local, que en Render NO es
# persistente (se borran en cada redeploy). Ahora se guardan en
# Supabase Storage.
#
# 1. Supabase → tu proyecto → Storage → New bucket → nómbralo "uploads"
#    y márcalo como Public.
# 2. Supabase → Project Settings → API → copia "Project URL" en
#    SUPABASE_URL, y la clave "service_role" (NO la "anon") en
#    SUPABASE_SERVICE_ROLE_KEY. La service_role key nunca debe usarse
#    en el frontend, solo aquí en el backend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_STORAGE_BUCKET=uploads
