# URL del backend (FastAPI en Render)
# En desarrollo local puedes dejarla vacía o apuntar a http://localhost:8000
# En producción (Vercel), configura esta variable en el dashboard de Vercel
# con la URL real de tu servicio de Render, por ejemplo:
# VITE_API_URL=https://microjobs-backend.onrender.com
VITE_API_URL=http://localhost:8000
